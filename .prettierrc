# Specification: http://json.schemastore.org/prettierrc
# Documentation: https://prettier.io/docs/en/index.html

# Plugins
plugins:
    - ./node_modules/@prettier/plugin-php
    - ./node_modules/@prettier/plugin-ruby
    - ./node_modules/@prettier/plugin-xml
    - ./node_modules/prettier-plugin-java

# General settings
useTabs: false
tabWidth: 4
printWidth: 120
singleQuote: false
trailingComma: none
endOfLine: lf
semi: false
proseWrap: preserve

# Language specific settings
overrides:

    # Officially supported languages

    -   files: "*.css"
        options:
            parser: css

    -   files:
            - "*.html"
            - "*.html5"
        options:
            parser: html
            htmlWhitespaceSensitivity: ignore

    -   files:
            - "*.js"
            - "*.javascript"
        options:
            parser: babel
            trailingComma: es5
            semi: true

    -   files:
            - "*.json"
        options:
            parser: json
            semi: false

    -   files:
            - "*.less"
        options:
            parser: less

    -   files:
            - "*.md"
            - "*.MD"
            - "*.markdown"
        options:
            parser: markdown

    -   files: "*.scss"
        options:
            parser: scss

    -   files:
            - "*.yaml"
            - "*.yml"
        options:
            parser: yaml
            singleQuote: false
            tabWidth: 2
            trailingComma: none

    # Official plugin : https://github.com/prettier/plugin-php
    -   files:
            - "*.php"
            - "*.phar"
        options:
            parser: php
            phpVersion: "7.3"
            singleQuote: true
            trailingCommaPHP: true
            braceStyle: "psr-2"

    # Official plugin : https://github.com/prettier/plugin-ruby
    -   files:
            - "*.rb"
            - "*.ruby"
        options:
            parser: ruby

    # Official plugin : https://github.com/prettier/plugin-xml
    -   files:
            - "*.xml"
        options:
            parser: xml

    # Unofficial plugin : https://github.com/jhipster/prettier-java
    -   files:
            - "*.java"
        options:
            parser: java
